# Скопируйте этот файл в .env и поменяйте нужное. Все строки необязательны.

# Название диска — видно в шапке и на странице входа
DISK_NAME=Диск

# Хранилище: диск или папка, которую видит администратор (например, весь диск D:).
# Если не указать, путь спрашивается при первом запуске и меняется в разделе «Хранилище».
# STORAGE_DIR=D:\

# Где лежат база и служебные файлы (по умолчанию папка data рядом с программой)
# DATA_DIR=D:\CloudDisk\_data

# Порт сайта: http://<адрес ПК>:5000
PORT=5000

# 0.0.0.0 — доступ из домашней сети; 127.0.0.1 — только с этого ПК
HOST=0.0.0.0

# Предел размера одной загрузки, МБ
MAX_UPLOAD_MB=4096
